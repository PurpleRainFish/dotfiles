
# set
set guioptions 'cshv'
set selection-clipboard clipboard
set font "Maple Mono NF CN"
set synctex true
set synctex-editor-command "nvr --remote-silent +%{line} %{input}"

# map
map <C--> zoom out
map <C-=> zoom in

